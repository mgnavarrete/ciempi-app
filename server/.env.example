# Copiar como server/.env (y en el servidor: chmod 600 server/.env).

# PostgreSQL. En desarrollo, el de docker-compose (npm run db:start).
DATABASE_URL=postgres://ciempi:ciempi@localhost:5434/ciempi

# Puerto interno; nginx (o el proxy de Vite en desarrollo) le manda /api/.
PORT=3200
HOST=127.0.0.1

# Voz de Ciempi con Microsoft Azure (Lorenzo para niño, Paloma para niña).
# Sin clave, o si Azure falla, se usa Piper (VOZ_URL). Ver docs/despliegue.md.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
# AZURE_VOZ_NINO=es-CL-LorenzoNeural
# AZURE_VOZ_NINA=es-US-PalomaNeural

# Voz de Ciempi con xAI (Leo para niño, Ara para niña), en español de México.
# Necesita una clave de API de https://console.x.ai (con saldo; la suscripción a Grok no la incluye).
XAI_API_KEY=
# XAI_VOZ_NINO=leo
# XAI_VOZ_NINA=ara
# XAI_IDIOMA=es-MX

# Servicio de voz de Ciempi (server/voz, Piper). Sin él ni Azure, la app usa la voz del teléfono.
VOZ_URL=http://127.0.0.1:3201

# Dirección pública de la app: el enlace de "recuperar contraseña" apunta aquí.
APP_URL=http://localhost:5173

# Correo para recuperar contraseñas. Sin SMTP_HOST, el enlace se escribe en el
# registro del servidor (journalctl -u ciempi-api) en vez de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ciempi <no-responder@minttu.cl>
