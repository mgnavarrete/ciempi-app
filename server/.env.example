# Copiar como server/.env (y en el servidor: chmod 600 server/.env).

# PostgreSQL. En desarrollo, el de docker-compose (npm run db:start).
DATABASE_URL=postgres://ciempi:ciempi@localhost:5434/ciempi

# Puerto interno; nginx (o el proxy de Vite en desarrollo) le manda /api/.
PORT=3200
HOST=127.0.0.1

# Dirección pública de la app: el enlace de "recuperar contraseña" apunta aquí.
APP_URL=http://localhost:5173

# Correo para recuperar contraseñas. Sin SMTP_HOST, el enlace se escribe en el
# registro del servidor (journalctl -u ciempi-api) en vez de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ciempi <no-responder@minttu.cl>
