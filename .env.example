# Copia este archivo como .env.local.
#
# Con el servidor de Ciempi (carpeta server/, Node + PostgreSQL):
#   VITE_API_URL=/                          la web y el servidor en el mismo sitio (dev y nginx)
#   VITE_API_URL=https://ciempi.minttu.cl   (lo usa la APK, en .env.apk)
# Sin VITE_API_URL la app funciona sin conexión, guardando todo en este dispositivo.
VITE_API_URL=/
