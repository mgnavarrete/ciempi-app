# Copia este archivo como .env.local. Sin estas variables, la app funciona
# sin conexión guardando todo en este dispositivo.
#
# Supabase local (npm run db:start; los valores salen con npm run db:env):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<ANON_KEY>
#
# Supabase en la nube: Project Settings → API.
# La anon/publishable key es pública por diseño: los datos los protege la RLS.
# NUNCA pongas aquí la service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
