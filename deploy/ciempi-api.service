# Servicio systemd del servidor de Ciempi.
# Copiar a /etc/systemd/system/ciempi-api.service. Ajustar User si la carpeta
# no es de `mint` y la ruta de node si `which node` no es /usr/bin/node.
[Unit]
Description=Ciempi API
After=network.target postgresql.service

[Service]
Type=simple
User=mint
WorkingDirectory=/var/www/ciempi-app/server
ExecStart=/usr/bin/node --env-file=.env src/index.ts
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
# Endurecimiento: el proceso no puede escribir fuera de lo necesario.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
