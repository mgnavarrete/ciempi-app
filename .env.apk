# APK: se conecta al servidor publicado.
VITE_API_URL=https://ciempi.minttu.cl
# Economía E2 en modo local (sin cuenta); con cuenta manda el servidor (ECONOMIA=e2 en server/.env).
VITE_ECONOMIA=e2
# Canal de distribución: "directo" = APK compartida a mano (avisa si hay una APK nueva que
# descargar); "tienda" = Google Play / App Store (las tiendas actualizan la APK, sin aviso).
VITE_CANAL=directo
